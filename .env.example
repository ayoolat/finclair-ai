# Application
APP_NAME=Finclair AI
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/finclair

# Auth
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis / RQ
REDIS_URL=redis://localhost:6379/0

# SMTP — works with Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@finclair.ai
SMTP_FROM_NAME=Finclair

# OTP
OTP_EXPIRE_MINUTES=10

# Cross-server email queue access key — generate with: openssl rand -hex 32
EMAIL_API_KEY=change-me

# Frontend URL — used in email links
FRONTEND_URL=http://localhost:3000
