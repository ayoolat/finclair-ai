# Application
APP_NAME=Finclair AI
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/finclair

# Auth
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis / RQ
REDIS_URL=redis://localhost:6379/0

# SMTP — works with Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=mail.tkbafrica.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@finclair.ai
SMTP_FROM_NAME=Finclair AI

# OTP
OTP_EXPIRE_MINUTES=10

# Cross-server email queue access key — generate with: openssl rand -hex 32
EMAIL_API_KEY=change-me

# Frontend URL — used in email links
FRONTEND_URL=http://localhost:3000

# Mono — bank account linking and transaction sync
MONO_PUBLIC_KEY=test_pk_your_public_key_here
MONO_SECRET_KEY=test_sk_your_secret_key_here
MONO_WEBHOOK_SECRET=your_webhook_secret_here

# Paystack — bank list sync + subscription billing
PAYSTACK_SECRET_KEY=sk_test_paystack_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_paystack_your_key_here

# OpenAI — receipt OCR (gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-key-here
OCR_PROVIDER=openai

# Firebase — social auth (Google & Apple)
# Paste the entire service account JSON as a single-line string
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id",...}

# Google service account — lets Clara read the app-help Google Doc.
# Share the doc with this service account's `client_email` (Viewer access).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
CLARA_HELP_DOC_ID=1-q1W4-9fvVHO_rRW-PPnGhn-8owmeXLSRO5W0RSQiic

# Digital Ocean Spaces — file storage
STORAGE_PROVIDER=spaces
SPACES_KEY=your-do-access-key
SPACES_SECRET=your-do-secret-key
SPACES_REGION=nyc3
SPACES_BUCKET=your-bucket-name
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_CDN_URL=https://your-bucket-name.nyc3.cdn.digitaloceanspaces.com
